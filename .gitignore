# Data (downloaded by scripts/01 and scripts/02)
data_raw/**
!data_raw/**/.gitkeep
data_processed/**
!data_processed/.gitkeep

# Generated outputs (regenerated by the pipeline)
outputs/**
!outputs/**/.gitkeep

# Models and intermediate artefacts
*.pkl
*.parquet

# Manuscript / submission artefacts (distributed separately)
*.docx
*.pdf

# Secrets
*key*.txt
.keys.json
.env

# Python
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.venv/

# OS
.DS_Store
Thumbs.db
